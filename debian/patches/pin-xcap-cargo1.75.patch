Description: Pin xcap to an edition-2021 release compatible with Ubuntu cargo 1.75
 Launchpad's Ubuntu 24.04 builders ship cargo 1.75, which cannot parse crates
 that require edition2024. xcap >= 0.6 uses edition2024; pin to 0.5.x.
Forwarded: not-needed (packaging-only)
Author: Jackson Delahunt <jackson@jacksondelahunt.com>

--- a/screenpipe-vision/Cargo.toml
+++ b/screenpipe-vision/Cargo.toml
@@ -49,7 +49,7 @@
 git = "https://github.com/louis030195/sck-rs"

 [target.'cfg(not(target_os = "macos"))'.dependencies]
-xcap = "0.8.1"
+xcap = "0.5.0"

 [dev-dependencies]
 tempfile = "3.3.0"
