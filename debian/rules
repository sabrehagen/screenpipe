#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export RUST_BACKTRACE = 1
export CARGO_NET_OFFLINE = true

%:
	dh $@

override_dh_auto_configure:
	@test -d vendor || (echo "missing vendor. run scripts/ppa/prepare-source.sh" && false)

override_dh_auto_build:
	# build cli (screenpipe-server -> bin: screenpipe)
	rm -rf debian/cargo-home-workspace
	mkdir -p debian/cargo-home-workspace
	cp debian/cargo-config-workspace.toml debian/cargo-home-workspace/config.toml
	CARGO_HOME="$(CURDIR)/debian/cargo-home-workspace" \
		cargo build --release --locked --offline -p screenpipe-server --bin screenpipe

override_dh_auto_test:
	# skip tests in ppa builds (heavy hardware-dependent integration tests)
	true
